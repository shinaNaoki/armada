# nabu / SM8150 kernel 7.2.6 forward-port additions
# Apply AFTER using the device's running 7.0 config as the base:
#   cp nabu-7.0-running.config .config
#   cat nabu-kernel-additions.config >> .config
#   make olddefconfig
# Then verify every requested =y survived (grep '^CONFIG_X=y' .config).

# --- nabu SoC / display / audio (must-have for the port) -------------------
CONFIG_ARCH_QCOM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_NOVATEK_NT36523=y
CONFIG_BACKLIGHT_KTZ8866=y

# WCD9340 (SLIMbus) + 4x CS35L41 speaker amps + Q6 DSP
CONFIG_SLIMBUS=y
CONFIG_SLIM_QCOM_NGD_CTRL=m
CONFIG_QCOM_APR=y
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_SM8150=y
CONFIG_SND_SOC_WCD934X=m
CONFIG_SND_SOC_CS35L41=m
CONFIG_SND_SOC_CS35L41_I2C=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_QCOM_Q6V5_ADSP=m
CONFIG_QCOM_Q6V5_PAS=m

# nabu peripherals
CONFIG_QCOM_TSENS=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ATH10K_SNOC=m
CONFIG_USB_DWC3=y
CONFIG_TYPEC=y

# --- Armada userland requirements (optional for pure Arch validation) -----
# Keep these in the same kernel so the later Armada switch needs no rebuild.
CONFIG_NTSYNC=y
CONFIG_BINFMT_MISC=m
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=m
CONFIG_ZRAM=m
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_FANOTIFY=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
CONFIG_HID_STEAM=m
CONFIG_HID_NINTENDO=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_NTFS3_FS=m
CONFIG_CIFS=m
CONFIG_EXFAT_FS=m

# nabu touchscreen: down-stream Novatek NT36523 SPI driver (0005)
CONFIG_TOUCHSCREEN_NT36523_SPI=m
