# Armada userland requirements that the device's 7.0 config lacks.
# Source: armada/packages/kernel/config/armada-kernel.config.overrides
# (generic sections: gaming/scheduler/debug, bootc/ostree/systemd, HID/rumble,
# Waydroid, netfilter, crypto). Device-specific options for Armada's other
# handhelds (panels/PMICs/other SoCs/joysticks) are intentionally NOT copied.
#
# Applied after nabu-7.0-running.config + nabu-kernel-additions.config:
#   make olddefconfig
# See CONFIG-REPORT.md for the full diff and rationale.

# --- scheduler / debug / tracing (armada-powerd, scx_lavd, sleep-debug, BTF) --
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# --- early display handoff / splash (Armada splash + fbcon) ------------------
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y

# --- zram / crypto (Fedora userspace, iwd, zram) ----------------------------
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_MD5=y

# --- Waydroid / container networking ---------------------------------------
CONFIG_IPV6=y
CONFIG_NET_KEY=y
CONFIG_XFRM_USER=y
CONFIG_NFT_REDIR=m
CONFIG_NETFILTER_XT_TARGET_MARK=m

# --- controllers / rumble (external pads on a tablet) ----------------------
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_NINTENDO_FF=y
CONFIG_PLAYSTATION_FF=y
CONFIG_SONY_FF=y
CONFIG_STEAM_FF=y

# --- misc Armada generic ----------------------------------------------------
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_QCOM_PMIC_PDCHARGER_ULOG=m
