diff -ruN a/drivers/media/platform/qcom/iris/iris_vpu_sm8150.c b/drivers/media/platform/qcom/iris/iris_vpu_sm8150.c
--- a/drivers/media/platform/qcom/iris/iris_vpu_sm8150.c	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/media/platform/qcom/iris/iris_vpu_sm8150.c	2026-10-19 14:51:17.808969183 +0800
@@ -0,0 +1,447 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2026 The Qualcomm SM8150 mainline community
+ *
+ * VPU hardware operations for Qualcomm SM8150 (Iris generation, HFI 1.0).
+ *
+ * SM8150 keeps the legacy Venus register window layout (VBIF @0x80000,
+ * CPU @0xc0000 with CPU_CS @+0x12000 and CPU_IC @+0x1f000, wrapper @0xe0000)
+ * while speaking the same HFI 1.0 protocol as iris gen1, hence a dedicated
+ * set of vpu_ops instead of iris_vpu2_ops (which assumes the "v6" layout with
+ * the CPU window at 0xa0000 and an AON wrapper).
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/moduleparam.h>
+#include <linux/iommu.h>
+#include <linux/kernel.h>
+#include <linux/of_address.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/sizes.h>
+
+#include "iris_core.h"
+#include "iris_hfi_common.h"
+#include "iris_firmware.h"
+#include "iris_hfi_queue.h"
+#include "iris_instance.h"
+#include "iris_resources.h"
+#include "iris_vpu_common.h"
+
+/* legacy Venus register layout */
+#define SM8150_VBIF_BASE		0x00080000
+#define SM8150_CPU_BASE			0x000c0000
+#define SM8150_CPU_CS_BASE		(SM8150_CPU_BASE + 0x00012000)
+#define SM8150_CPU_IC_BASE		(SM8150_CPU_BASE + 0x0001f000)
+#define SM8150_WRAPPER_BASE		0x000e0000
+
+/* CPU_CS */
+#define SM8150_CPU_CS_A2HSOFTINTCLR	0x1c
+#define SM8150_CTRL_INIT		0x48
+#define SM8150_CTRL_STATUS		0x4c
+#define SM8150_QTBL_INFO		0x50
+#define SM8150_QTBL_ADDR		0x54
+#define SM8150_CPU_CS_SCIACMDARG3	0x58
+#define SM8150_SFR_ADDR			0x5c
+#define SM8150_UC_REGION_ADDR		0x64
+#define SM8150_UC_REGION_SIZE		0x68
+
+/* DSP (CVP) queue window, used when the firmware exposes the CVP domain */
+#define SM8150_DSP_QTBL_ADDR		0x34
+#define SM8150_DSP_UC_REGION_ADDR	0x38
+#define SM8150_DSP_UC_REGION_SIZE	0x3c
+
+/* CPU_IC */
+#define SM8150_CPU_IC_SOFTINT		0x18
+
+/* wrapper */
+#define SM8150_WRAPPER_HW_VERSION	0x00
+#define SM8150_WRAPPER_INTR_STATUS	0x0c
+#define SM8150_WRAPPER_INTR_MASK	0x10
+#define SM8150_WRAPPER_INTR_CLEAR	0x14
+#define SM8150_WRAPPER_CPU_CGC_DIS	0x2010
+#define SM8150_WRAPPER_CPU_CLOCK_CONFIG	0x2000
+#define SM8150_WRAPPER_CPU_STATUS	0x2014
+#define SM8150_WRAPPER_A9SS_SW_RESET	0x3000
+#define SM8150_WRAPPER_FW_START_ADDR	0x1028
+#define SM8150_WRAPPER_FW_END_ADDR	0x102c
+#define SM8150_WRAPPER_CPA_START_ADDR	0x1020
+#define SM8150_WRAPPER_CPA_END_ADDR	0x1024
+#define SM8150_WRAPPER_NONPIX_START_ADDR 0x1030
+#define SM8150_WRAPPER_NONPIX_END_ADDR	0x1034
+
+/* VBIF */
+#define SM8150_VBIF_CLKON		0x04
+#define SM8150_VBIF_AXI_HALT_CTRL0	0x208
+#define SM8150_VBIF_AXI_HALT_CTRL1	0x20c
+
+/* bit fields */
+#define SM8150_WRAPPER_INTR_STATUS_A2HWD_BMSK	BIT(4)
+#define SM8150_WRAPPER_INTR_MASK_A2HWD_BMSK	BIT(4)
+#define SM8150_WRAPPER_INTR_MASK_A2HCPU_BMSK	BIT(2)
+#define SM8150_WRAPPER_INTR_MASK_A2HVCODEC_BMSK	BIT(3)
+#define SM8150_WRAPPER_CPU_STATUS_WFI		BIT(0)
+#define SM8150_WRAPPER_A9SS_SW_RESET_BIT	BIT(4)
+
+#define SM8150_CTRL_STATUS_IDLE_MSG_BMSK	BIT(30)
+#define SM8150_CTRL_ERROR_STATUS__M		0xfe
+#define SM8150_CTRL_STATUS_PC_READY		BIT(8)
+
+#define SM8150_VBIF_CLKON_FORCE_ON		BIT(0)
+#define SM8150_AXI_HALT_REQ			BIT(0)
+#define SM8150_AXI_HALT_ACK			BIT(0)
+
+#define SM8150_CPU_IC_SOFTINT_H2A_SHFT		0xf
+#define SM8150_CLEAR_XTENSA2HOST_INTR		BIT(0)
+#define SM8150_QTBL_ENABLE			BIT(0)
+
+/* size of the firmware/CP reserved region (venus_mem, 5 MiB) */
+#define SM8150_FW_REGION_SIZE			0x500000
+#define SM8150_POLL_INTERVAL_US			50
+#define SM8150_HALT_ACK_TIMEOUT_US		500000
+#define SM8150_BOOT_MAX_TRIES			1000
+
+/* TEMPORARY bring-up knobs (see file header) */
+static int sm8150_boot_stage = 3;
+module_param(sm8150_boot_stage, int, 0644);
+static int sm8150_sec_win;
+module_param(sm8150_sec_win, int, 0644);
+static int sm8150_map_fw = 1;
+module_param(sm8150_map_fw, int, 0644);
+
+static void *sm8150_wrapper(struct iris_core *core)
+{
+	return core->reg_base + SM8150_WRAPPER_BASE;
+}
+
+static void *sm8150_cpu_cs(struct iris_core *core)
+{
+	return core->reg_base + SM8150_CPU_CS_BASE;
+}
+
+static void *sm8150_vbif(struct iris_core *core)
+{
+	return core->reg_base + SM8150_VBIF_BASE;
+}
+
+static void iris_vpu_sm8150_halt_axi(struct iris_core *core)
+{
+	void __iomem *vbif = sm8150_vbif(core);
+	u32 val;
+	int ret;
+
+	val = readl(vbif + SM8150_VBIF_AXI_HALT_CTRL0);
+	val |= SM8150_AXI_HALT_REQ;
+	writel(val, vbif + SM8150_VBIF_AXI_HALT_CTRL0);
+
+	ret = readl_poll_timeout(vbif + SM8150_VBIF_AXI_HALT_CTRL1, val,
+				 val & SM8150_AXI_HALT_ACK,
+				 SM8150_POLL_INTERVAL_US,
+				 SM8150_HALT_ACK_TIMEOUT_US);
+	if (ret)
+		dev_warn(core->dev, "AXI halt timeout\n");
+}
+
+void iris_vpu_sm8150_set_preset_registers(struct iris_core *core)
+{
+	void __iomem *wrapper = sm8150_wrapper(core);
+
+	iris_dbg(core, "IRISDBG: sm8150: program wrapper regs\n");
+	writel(0x0, wrapper + SM8150_WRAPPER_CPU_CGC_DIS);
+	writel(0x0, wrapper + SM8150_WRAPPER_CPU_CLOCK_CONFIG);
+
+}
+
+static void iris_vpu_sm8150_interrupt_init(struct iris_core *core)
+{
+	void __iomem *wrapper = sm8150_wrapper(core);
+	u32 mask_val;
+
+	mask_val = readl(wrapper + SM8150_WRAPPER_INTR_MASK);
+	mask_val &= ~(SM8150_WRAPPER_INTR_MASK_A2HWD_BMSK |
+		      SM8150_WRAPPER_INTR_MASK_A2HCPU_BMSK);
+	writel(mask_val, wrapper + SM8150_WRAPPER_INTR_MASK);
+}
+
+static void iris_vpu_sm8150_raise_interrupt(struct iris_core *core)
+{
+	writel(BIT(SM8150_CPU_IC_SOFTINT_H2A_SHFT),
+	       core->reg_base + SM8150_CPU_IC_BASE + SM8150_CPU_IC_SOFTINT);
+}
+
+static void iris_vpu_sm8150_clear_interrupt(struct iris_core *core)
+{
+	void __iomem *wrapper = sm8150_wrapper(core);
+	void __iomem *cpu_cs = sm8150_cpu_cs(core);
+	u32 intr_status, mask;
+
+	intr_status = readl(wrapper + SM8150_WRAPPER_INTR_STATUS);
+	mask = SM8150_WRAPPER_INTR_STATUS_A2HWD_BMSK |
+	       SM8150_WRAPPER_INTR_MASK_A2HCPU_BMSK |
+	       SM8150_CTRL_STATUS_IDLE_MSG_BMSK;
+	if (intr_status & mask)
+		core->intr_status |= intr_status;
+
+	writel(SM8150_CLEAR_XTENSA2HOST_INTR,
+	       cpu_cs + SM8150_CPU_CS_A2HSOFTINTCLR);
+	writel(intr_status, wrapper + SM8150_WRAPPER_INTR_CLEAR);
+}
+
+static int iris_vpu_sm8150_watchdog(struct iris_core *core, u32 intr_status)
+{
+	if (intr_status & SM8150_WRAPPER_INTR_STATUS_A2HWD_BMSK) {
+		dev_err(core->dev, "received watchdog interrupt\n");
+		return -ETIME;
+	}
+
+	return 0;
+}
+
+static void iris_vpu_sm8150_power_off_hw(struct iris_core *core)
+{
+	void __iomem *wrapper = sm8150_wrapper(core);
+	void __iomem *vbif = sm8150_vbif(core);
+	u32 val;
+
+	/* assert ARM9 reset */
+	val = readl(wrapper + SM8150_WRAPPER_A9SS_SW_RESET);
+	val |= SM8150_WRAPPER_A9SS_SW_RESET_BIT;
+	writel(val, wrapper + SM8150_WRAPPER_A9SS_SW_RESET);
+	wmb();
+
+	/* keep the VBIF clock on so the AXI halt handshake can complete */
+	val = readl(vbif + SM8150_VBIF_CLKON);
+	val |= SM8150_VBIF_CLKON_FORCE_ON;
+	writel(val, vbif + SM8150_VBIF_CLKON);
+
+	iris_dbg(core, "IRISDBG: sm8150: halt AXI\n");
+	iris_vpu_sm8150_halt_axi(core);
+
+	iris_vpu_power_off_hw(core);
+}
+
+static int iris_vpu_sm8150_power_on_controller(struct iris_core *core)
+{
+	int ret;
+
+	ret = iris_vpu_power_on_controller(core);
+	if (ret)
+		return ret;
+
+	/* HANA additionally needs the second AXI clock up for its bridges */
+	iris_dbg(core, "IRISDBG: sm8150: enable AXI1 clk\n");
+	iris_prepare_enable_clock(core, IRIS_BSE_HW_CLK);
+
+	/* ... and the CVP power domain + core clock, exactly like downstream */
+	iris_dbg(core, "IRISDBG: sm8150: enable CVP domain/clk\n");
+	ret = iris_enable_power_domains(core, core->pmdomain_tbl->pd_devs[2]);
+	if (ret)
+		iris_dbg(core, "IRISDBG: sm8150: CVP domain ret=%d\n", ret);
+	iris_prepare_enable_clock(core, IRIS_HW_AHB_CLK);
+
+	return 0;
+}
+
+static int iris_vpu_sm8150_power_off_controller(struct iris_core *core)
+{
+	iris_dbg(core, "IRISDBG: sm8150: disable controller clocks\n");
+	iris_disable_unprepare_clock(core, IRIS_HW_AHB_CLK);
+	iris_disable_power_domains(core, core->pmdomain_tbl->pd_devs[2]);
+	iris_disable_unprepare_clock(core, IRIS_BSE_HW_CLK);
+	iris_disable_unprepare_clock(core, IRIS_AXI1_CLK);
+	iris_disable_unprepare_clock(core, IRIS_AHB_CLK);
+	iris_disable_unprepare_clock(core, IRIS_CTRL_CLK);
+	iris_disable_unprepare_clock(core, IRIS_AXI_CLK);
+	iris_disable_power_domains(core, core->pmdomain_tbl->pd_devs[IRIS_CTRL_POWER_DOMAIN]);
+
+	return 0;
+}
+
+static int iris_vpu_sm8150_prepare_pc(struct iris_core *core)
+{
+	void __iomem *cpu_cs = sm8150_cpu_cs(core);
+	void __iomem *wrapper = sm8150_wrapper(core);
+	u32 ctrl_status, cpu_status, val = 0;
+	int ret;
+
+	ctrl_status = readl(cpu_cs + SM8150_CTRL_STATUS);
+	if (ctrl_status & SM8150_CTRL_STATUS_PC_READY)
+		return 0;
+
+	cpu_status = readl(wrapper + SM8150_WRAPPER_CPU_STATUS);
+	cpu_status &= SM8150_WRAPPER_CPU_STATUS_WFI;
+
+	if (!cpu_status || !(ctrl_status & SM8150_CTRL_STATUS_IDLE_MSG_BMSK)) {
+		dev_err(core->dev, "skip power collapse, wfi=%#x, ctrl=%#x\n",
+			cpu_status, ctrl_status);
+		return -EAGAIN;
+	}
+
+	ret = core->hfi_ops->sys_pc_prep(core);
+	if (ret)
+		return ret;
+
+	ret = readl_poll_timeout(cpu_cs + SM8150_CTRL_STATUS, val,
+				 val & SM8150_CTRL_STATUS_PC_READY, 250, 2500);
+	if (ret) {
+		dev_err(core->dev, "power collapse not acked, ctrl=%#x\n", val);
+		return -EAGAIN;
+	}
+
+	return 0;
+}
+
+static int iris_vpu_sm8150_map_fw_iova0(struct iris_core *core)
+{
+	struct iommu_domain *domain;
+	struct resource res;
+	phys_addr_t mem_phys;
+	size_t size;
+	int ret;
+
+	ret = of_reserved_mem_region_to_resource(core->dev->of_node, 0, &res);
+	if (ret) {
+		dev_err(core->dev, "no firmware memory-region (%d)\n", ret);
+		return ret;
+	}
+
+	mem_phys = res.start;
+	size = resource_size(&res);
+
+	domain = iommu_get_domain_for_dev(core->dev);
+	if (!domain) {
+		dev_err(core->dev, "no IOMMU domain for the video device\n");
+		return -ENODEV;
+	}
+
+	ret = iommu_map(domain, 0, mem_phys, size,
+			IOMMU_READ | IOMMU_WRITE | IOMMU_PRIV, GFP_KERNEL);
+	iris_dbg(core, "IRISDBG: s8150: map fw at IOVA0 (%#llx+%#zx) ret=%d\n",
+		 (unsigned long long)mem_phys, size, ret);
+
+	return ret;
+}
+
+static int iris_vpu_sm8150_boot_firmware(struct iris_core *core)
+{
+	void __iomem *wrapper = sm8150_wrapper(core);
+	void __iomem *cpu_cs = sm8150_cpu_cs(core);
+	u32 ctrl_init = BIT(0) | BIT(1), ctrl_status = 0;
+	u32 queue_size, value, count = 0;
+	u32 fw_size = SM8150_FW_REGION_SIZE;
+	int ret;
+
+	iris_dbg(core, "IRISDBG: s8150: read wrapper hw version\n");
+	{
+		u32 hw_ver = readl(wrapper + SM8150_WRAPPER_HW_VERSION);
+
+		iris_dbg(core, "IRISDBG: s8150: hw version=%#x\n", hw_ver);
+	}
+
+	ret = iris_set_hw_state(core, true);
+	iris_dbg(core, "IRISDBG: s8150: set remote state (resume) ret=%d\n", ret);
+
+	if (sm8150_map_fw) {
+		ret = iris_vpu_sm8150_map_fw_iova0(core);
+		if (ret)
+			return ret;
+	}
+
+	if (sm8150_sec_win) {
+		iris_dbg(core, "IRISDBG: s8150: write SEC CPA/FW window\n");
+		writel_relaxed(0, wrapper + SM8150_WRAPPER_CPA_START_ADDR);
+		writel_relaxed(fw_size, wrapper + SM8150_WRAPPER_CPA_END_ADDR);
+		writel_relaxed(0, wrapper + SM8150_WRAPPER_FW_START_ADDR);
+		writel_relaxed(fw_size, wrapper + SM8150_WRAPPER_FW_END_ADDR);
+		writel_relaxed(fw_size, wrapper + SM8150_WRAPPER_NONPIX_START_ADDR);
+		writel_relaxed(fw_size, wrapper + SM8150_WRAPPER_NONPIX_END_ADDR);
+		iris_dbg(core, "IRISDBG: s8150: release ARM9 reset\n");
+		writel_relaxed(0, wrapper + SM8150_WRAPPER_A9SS_SW_RESET);
+		iris_dbg(core, "IRISDBG: s8150: SEC window done\n");
+	}
+
+	if (sm8150_boot_stage <= 1) {
+		iris_dbg(core, "IRISDBG: s8150: stage 1 done, parking\n");
+		msleep(120000);
+		return -ETIME;
+	}
+
+	queue_size = ALIGN(sizeof(struct iris_hfi_queue_table_header) +
+			   (IFACEQ_QUEUE_SIZE * IFACEQ_NUMQ), SZ_4K);
+	value = ALIGN(SFR_SIZE + queue_size, SZ_1M);
+
+	iris_dbg(core, "IRISDBG: s8150: UC_REGION_ADDR (qtab=%pad)\n",
+		 &core->iface_q_table_daddr);
+	writel((u32)core->iface_q_table_daddr, cpu_cs + SM8150_UC_REGION_ADDR);
+	iris_dbg(core, "IRISDBG: s8150: UC_REGION_SIZE=%#x\n", value);
+	writel(value, cpu_cs + SM8150_UC_REGION_SIZE);
+	iris_dbg(core, "IRISDBG: s8150: QTBL_ADDR\n");
+	writel((u32)core->iface_q_table_daddr, cpu_cs + SM8150_QTBL_ADDR);
+	iris_dbg(core, "IRISDBG: s8150: QTBL_INFO\n");
+	writel(SM8150_QTBL_ENABLE, cpu_cs + SM8150_QTBL_INFO);
+	if (core->sfr_daddr) {
+		iris_dbg(core, "IRISDBG: s8150: SFR_ADDR\n");
+		writel((u32)core->sfr_daddr, cpu_cs + SM8150_SFR_ADDR);
+	}
+
+	iris_dbg(core, "IRISDBG: s8150: DSP queue window\n");
+	writel((u32)core->iface_q_table_daddr, cpu_cs + SM8150_DSP_QTBL_ADDR);
+	writel((u32)core->iface_q_table_daddr, cpu_cs + SM8150_DSP_UC_REGION_ADDR);
+	writel(value, cpu_cs + SM8150_DSP_UC_REGION_SIZE);
+
+	if (sm8150_boot_stage <= 2) {
+		iris_dbg(core, "IRISDBG: s8150: stage 2 done, parking\n");
+		msleep(120000);
+		return -ETIME;
+	}
+
+	iris_dbg(core, "IRISDBG: s8150: WRAPPER_INTR_MASK\n");
+	writel(SM8150_WRAPPER_INTR_MASK_A2HVCODEC_BMSK,
+	       wrapper + SM8150_WRAPPER_INTR_MASK);
+	iris_dbg(core, "IRISDBG: s8150: SCIACMDARG3\n");
+	writel(0x1, cpu_cs + SM8150_CPU_CS_SCIACMDARG3);
+	iris_dbg(core, "IRISDBG: s8150: CTRL_INIT\n");
+	writel(ctrl_init, cpu_cs + SM8150_CTRL_INIT);
+
+	iris_dbg(core, "IRISDBG: s8150: first CTRL_STATUS read\n");
+	ctrl_status = readl(cpu_cs + SM8150_CTRL_STATUS);
+	iris_dbg(core, "IRISDBG: s8150: status after CTRL_INIT=%#x\n", ctrl_status);
+
+	while (!ctrl_status && count < SM8150_BOOT_MAX_TRIES) {
+		ctrl_status = readl(cpu_cs + SM8150_CTRL_STATUS);
+		if ((ctrl_status & SM8150_CTRL_ERROR_STATUS__M) == 0x4) {
+			dev_err(core->dev, "invalid setting for uc_region\n");
+			break;
+		}
+
+		usleep_range(50, 100);
+		count++;
+	}
+
+	iris_dbg(core, "IRISDBG: s8150: boot status=%#x tries=%u\n",
+		 ctrl_status, count);
+
+	if (count >= SM8150_BOOT_MAX_TRIES) {
+		dev_err(core->dev, "error booting up iris firmware\n");
+		return -ETIME;
+	}
+
+	iris_dbg(core, "IRISDBG: s8150: firmware booted\n");
+	return 0;
+}
+
+const struct vpu_ops iris_vpu_sm8150_ops = {
+	.power_off_hw = iris_vpu_sm8150_power_off_hw,
+	.power_on_hw = iris_vpu_power_on_hw,
+	.power_off_controller = iris_vpu_sm8150_power_off_controller,
+	.power_on_controller = iris_vpu_sm8150_power_on_controller,
+	.calc_freq = iris_vpu2_calc_freq,
+	.boot_firmware = iris_vpu_sm8150_boot_firmware,
+	.interrupt_init = iris_vpu_sm8150_interrupt_init,
+	.raise_interrupt = iris_vpu_sm8150_raise_interrupt,
+	.clear_interrupt = iris_vpu_sm8150_clear_interrupt,
+	.watchdog = iris_vpu_sm8150_watchdog,
+	.prepare_pc = iris_vpu_sm8150_prepare_pc,
+};
