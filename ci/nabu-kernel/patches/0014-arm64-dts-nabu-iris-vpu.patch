diff -ruN a/arch/arm64/boot/dts/qcom/sm8150.dtsi b/arch/arm64/boot/dts/qcom/sm8150.dtsi
--- a/arch/arm64/boot/dts/qcom/sm8150.dtsi	2026-10-19 14:51:17.830821215 +0800
+++ b/arch/arm64/boot/dts/qcom/sm8150.dtsi	2026-10-19 14:51:17.833977492 +0800
