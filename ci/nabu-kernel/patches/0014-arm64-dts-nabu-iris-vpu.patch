diff -ruN a/Documentation/devicetree/bindings/media/qcom,sm8150-iris.yaml b/Documentation/devicetree/bindings/media/qcom,sm8150-iris.yaml
--- a/Documentation/devicetree/bindings/media/qcom,sm8150-iris.yaml	1970-01-01 08:00:00.000000000 +0800
+++ b/Documentation/devicetree/bindings/media/qcom,sm8150-iris.yaml	2026-10-19 14:51:17.837384779 +0800
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/qcom,sm8150-iris.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SM8150 iris video encode and decode accelerators
+
+maintainers:
+  - The Qualcomm SM8150 mainline community
+
+description: |
+  The iris video processing unit is a video encode and decode accelerator
+  present on Qualcomm SM8150 and related SoCs.
+
+properties:
+  compatible:
+    enum:
+      - qcom,sm8150-iris
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 3
+
+  power-domain-names:
+    items:
+      - const: venus
+      - const: vcodec0
+      - const: mx
+
+  clocks:
+    maxItems: 3
+
+  clock-names:
+    items:
+      - const: iface
+      - const: core
+      - const: vcodec0_core
+
+  firmware-name:
+    maxItems: 1
+
+  interconnects:
+    maxItems: 2
+
+  interconnect-names:
+    items:
+      - const: cpu-cfg
+      - const: video-mem
+
+  resets:
+    maxItems: 2
+
+  reset-names:
+    items:
+      - const: bus
+      - const: core
+
+  iommus:
+    maxItems: 1
+
+  memory-region:
+    maxItems: 1
+
+  operating-points-v2: true
+
+  opp-table:
+    type: object
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - power-domains
+  - power-domain-names
+  - clocks
+  - clock-names
+  - interconnects
+  - interconnect-names
+  - resets
+  - reset-names
+  - iommus
+  - memory-region
+
+unevaluatedProperties: false
