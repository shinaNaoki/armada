# ArmadaOS requirements layered on top of Kumar-Jy's nabu_defconfig.
#
# The device (SM8150, Xiaomi Pad 5) configuration stays exactly as upstream
# nabu_defconfig provides it. This fragment only adds what Armada's userland,
# bootc/ostree image and debugging/performance stack need. Do NOT copy the old
# 7.2.6 forward-port device options here: the reference kernel already carries
# the nabu display/touch/audio/charging/SLPI/iris support and uses QCOM_BMS +
# CHARGER_IDTP9418 instead of the old fuel-gauge/charger patches.
#
# Applied by scripts/ci/build-kernel.sh:
#   make nabu_defconfig
#   scripts/kconfig/merge_config.sh .config ci/nabu/kernel.config
#   scripts/config --disable DEBUG_INFO_REDUCED
#   make olddefconfig

# --- version suffix --------------------------------------------------------
# Keep the kernel release deterministic: the Armada suffix is supplied via
# make EXTRAVERSION=..., while LOCALVERSION is forced empty on the command
# line. Disabling the automatic SCM suffix prevents "-g<sha>"/"-dirty" from
# leaking into /usr/lib/modules and the UKI name.
CONFIG_LOCALVERSION=""
CONFIG_LOCALVERSION_AUTO=n

# --- LSM / SELinux (Fedora bootc enforces SELinux) -------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf"

# --- bootc / ostree / composefs / initramfs --------------------------------
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_CONFIGFS_FS=y
CONFIG_RD_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_UNICODE=y
CONFIG_FANOTIFY=y

# --- BTF / tracing / scx / Armada debug tooling ----------------------------
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# --- scheduler / memory ----------------------------------------------------
CONFIG_SCHED_CLASS_EXT=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# --- early display / splash handoff ---------------------------------------
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y

# --- zram / crypto (Fedora userspace, iwd) ---------------------------------
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_MD5=y

# --- container / Waydroid / netfilter -------------------------------------
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NET_KEY=y
CONFIG_XFRM_USER=y
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_NFT_COMPAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m

# --- input / controllers / rumble ----------------------------------------
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_HID_STEAM=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_NINTENDO_FF=y
CONFIG_PLAYSTATION_FF=y
CONFIG_SONY_FF=y
CONFIG_STEAM_FF=y

# --- misc Armada userland --------------------------------------------------
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_PROC_CHILDREN=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_USB_NET_RNDIS_HOST=m
